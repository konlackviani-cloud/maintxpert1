# MaintXpert — API. Copier en .env et renseigner. Ne jamais committer .env.

NODE_ENV=development
PORT=3000

# Supabase local (npm run db:start) — mot de passe par défaut de la CLI.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase distant : Project Settings > Database > Connection string (URI).
# DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Secret de signature JWT — 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=a-remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum

# Origines autorisées (CORS), séparées par des virgules.
ORIGINES_AUTORISEES=http://localhost:5173

# Dossier de stockage des photos (en attendant le stockage objet Supabase).
STOCKAGE_PHOTOS=./donnees/photos
